const BGS=[["page","Whole page background (behind everything)","pagebg"],["hero","Top banner (hero)","hero"],["menu","Menu section","menu"],["book","Booking section","book"],["visit","Visit section","visit"]];
const okId=v=>typeof v==="string"&&/^[0-9a-f]{32}$/.test(v);
function applyBg(){const pg=$("pagebg"),pv=["page","hero","menu","book","visit"].map(k=>S.bg&&S.bg[k]).find(okId);if(pg){if(pv){pg.style.display="block";pg.style.backgroundImage="linear-gradient(rgba(20,10,5,.25),rgba(20,10,5,.4)),url(/_blob/"+pv+")"}else pg.style.display="none"}document.body.classList.toggle("haspg",!!pv);const sc=$("scene");if(sc)sc.style.display=okId(S.bg&&S.bg.hero)?"none":"block";BGS.forEach(([k,,id])=>{const el=$(id);if(!el||k==="page")return;const v=S.bg&&S.bg[k];
 if(okId(v)){el.style.backgroundImage=(k==="hero"?"linear-gradient(rgba(30,16,8,.55),rgba(30,16,8,.7))":"linear-gradient(var(--ov),var(--ov))")+",url(/_blob/"+v+")";el.style.backgroundSize="cover";el.style.backgroundPosition="center"}
 else{el.style.backgroundImage="";el.style.backgroundSize="";el.style.backgroundPosition=""}})}
function photosHtml(){return '<h4>Background photos</h4><p class="note">Upload your own café or food photos for each part of the site. They are resized automatically. Press Save &amp; Publish afterwards to make them live.</p><p class="note" id="phmsg"></p>'+BGS.map(([k,l])=>{const v=S.bg&&S.bg[k];
 return `<div class="tbox"><strong>${l}</strong>${okId(v)?`<img src="/_blob/${v}" alt="" style="max-width:200px;border-radius:10px;display:block;margin:6px 0">`:'<p class="note">Using the default design.</p>'}<input type="file" accept="image/*" data-bg="${k}" aria-label="Upload photo for ${l}"> ${okId(v)?`<button class="btn sm" data-p="rm" data-k="${k}">Remove</button>`:""}</div>`}).join("")}
$("adminRoot").addEventListener("change",async e=>{const f=e.target;if(!f.dataset||!f.dataset.bg||!f.files[0])return;const m=$("phmsg");m.textContent="Uploading…";
 try{const as=await claude.use("assets");if(!as){m.textContent="Only the page owner (signed in to claude.ai) can upload photos.";return}
  const bmp=await createImageBitmap(f.files[0]);const sc=Math.min(1,1600/Math.max(bmp.width,bmp.height));
  const cv=document.createElement("canvas");cv.width=Math.round(bmp.width*sc);cv.height=Math.round(bmp.height*sc);cv.getContext("2d").drawImage(bmp,0,0,cv.width,cv.height);
  const blob=await new Promise(r=>cv.toBlob(r,"image/jpeg",.82));const r=await as.upload(blob);
  S.bg=S.bg||{};S.bg[f.dataset.bg]=r.id;applyBg();renderAdmin();$("phmsg").textContent="Uploaded. Press Save & Publish to make it live.";
