 if(a==="addline"){const nm=DRAFT.name.trim(),pr=Number(DRAFT.price);if(!nm||DRAFT.price===""||!(pr>=0))return;DRAFT.lines.push([nm,DRAFT.qty,pr]);DRAFT.name="";DRAFT.price="";DRAFT.qty=1;renderTools()}
 else if(a==="rmline"){DRAFT.lines.splice(b.dataset.i,1);renderTools()}
 else if(a==="save"&&DB&&DRAFT.lines.length){b.disabled=true;try{await DB.collection("orders").add({t:Date.now(),src:"offline",type:DRAFT.type,table:DRAFT.table.trim(),pay:DRAFT.pay,paid:DRAFT.pay!=="Unpaid",lines:DRAFT.lines,total:DRAFT.lines.reduce((s,l)=>s+l[1]*l[2],0)});DRAFT.lines=[];DRAFT.table="";dbMsg=""}catch(x){dbMsg="Could not save order."}renderTools()}
 else if(a==="paid"&&DB){try{await DB.collection("orders").doc(b.dataset.id).update({paid:true,pay:"Cash"})}catch(x){dbMsg="Could not update payment.";renderTools()}}});
let ATAB="overview";const TABS=[["overview","Overview"],["offline","Offline order"],["bookings","Bookings"],["payments","Payments"],["popular","Popularity"],["photos","Photos"],["menu","Menu"],["details","Café details"]];
