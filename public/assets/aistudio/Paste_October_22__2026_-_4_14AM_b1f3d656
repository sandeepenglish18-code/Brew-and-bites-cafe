async function startDb(){if(sub)return;sub=true;
 try{DB=await claude.use("db")}catch(e){DB=null}
 if(!DB){dbMsg="Sign in to claude.ai as the page owner to save and see orders.";renderTools();return}
 DB.collection("bookings").limit(500).onSnapshot(s=>{const prev=BOOKS.filter(b=>b.status==="Pending").length;BOOKS=s.docs.flatMap(d=>((d.data().list)||[]).map((b,i)=>({...b,id:d.id,idx:i})));const n=BOOKS.filter(b=>b.status==="Pending").length;$("bnote").textContent=n?"ߔ "+n+" new booking"+(n>1?"s":"")+" waiting":"";if(n>prev&&BOOKSLOADED)beep();BOOKSLOADED=true;renderTools()},e=>{});DB.collection("orders").orderBy("t","desc").limit(500).onSnapshot(s=>{ORDERS=s.docs.map(d=>({id:d.id,...d.data()}));renderTools()},e=>{dbMsg="Could not load orders ("+(e.code||"error")+").";renderTools()})}
function renderTools(){const el=$("tools");if(!el)return;startDb();
 const opts=S.cats.flatMap((c,ci)=>c.items.map((it,ii)=>[ci+"-"+ii,it])).filter(([k,it])=>it[1]!=null&&it[2]);
 const dt=DRAFT.lines.reduce((a,l)=>a+l[1]*l[2],0);
 const by={},pop={};let sales=0,due=0;
 ORDERS.forEach(o=>{if(o.paid){by[o.pay]=(by[o.pay]||0)+o.total;sales+=o.total}else due+=o.total;o.lines.forEach(l=>pop[l[0]]=(pop[l[0]]||0)+l[1])});
 const top=Object.entries(pop).sort((a,b)=>b[1]-a[1]).slice(0,8),mx=top[0]?top[0][1]:1;
 const sel=(v,a)=>v===a?" selected":"";
 el.innerHTML=`${dbMsg?`<p class="note">${esc(dbMsg)}</p>`:""}
 <div class="tbox" data-tab="offline"><h4>Offline order</h4>
 <div class="row full"><input id="dName" list="dl" placeholder="Item name (type, or pick from menu)" value="${esc(DRAFT.name)}" aria-label="Item name"><datalist id="dl">${S.cats.flatMap(c=>c.items).map(i=>`<option value="${esc(i[0])}">`).join("")}</datalist></div>
 <div class="row"><input id="dPrice" type="number" min="0" placeholder="Price ₹" value="${esc(DRAFT.price)}" aria-label="Price"><input id="dQty" type="number" min="1" value="${DRAFT.qty}" aria-label="Quantity"><button class="btn sm" data-t="addline">Add item</button><span></span></div>
 ${DRAFT.lines.map((l,i)=>`<div class="bar"><span>${l[1]} x ${esc(l[0])}</span><span>${inr(l[1]*l[2])}</span><button class="btn sm" data-t="rmline" data-i="${i}" aria-label="Remove line">✕</button></div>`).join("")}
 <div class="row"><select id="dType" aria-label="Order type"><option${sel(DRAFT.type,"Dine-in")}>Dine-in</option><option${sel(DRAFT.type,"Takeaway")}>Takeaway</option></select><input id="dTable" placeholder="Table (dine-in)" value="${esc(DRAFT.table)}" aria-label="Table"><select id="dPay" aria-label="Payment"><option${sel(DRAFT.pay,"Cash")}>Cash</option><option${sel(DRAFT.pay,"UPI")}>UPI</option><option${sel(DRAFT.pay,"Card")}>Card</option><option${sel(DRAFT.pay,"Unpaid")}>Unpaid</option></select><span></span></div>
 <p><strong>Total ${inr(dt)}</strong> <button class="btn sm" data-t="save"${DB&&DRAFT.lines.length?"":" disabled"}>Save order</button></p>
 <p class="note">Only orders you enter here are stored. Website orders go to WhatsApp, so add them here too if you want them in your totals.</p></div>
 <div class="tbox" data-tab="payments"><h4>Payments</h4>
 <div class="stats"><div class="stat"><b>${inr(sales)}</b>Received</div><div class="stat"><b>${inr(due)}</b>Unpaid</div>${["Cash","UPI","Card"].map(m=>`<div class="stat"><b>${inr(by[m])}</b>${m}</div>`).join("")}</div>
 <table class="tbl">${ORDERS.slice(0,10).map(o=>`<tr><td>${new Date(o.t).toLocaleString("en-IN",{timeZone:"Asia/Kolkata",dateStyle:"short",timeStyle:"short"})}</td><td>${esc(o.type)}${o.table?" · T"+esc(o.table):""}</td><td>${inr(o.total)}</td><td>${o.paid?esc(o.pay)+" ✓":`<button class="btn sm" data-t="paid" data-id="${esc(o.id)}">Mark paid (cash)</button>`}</td></tr>`).join("")||"<tr><td>No orders yet.</td></tr>"}</table>
 <p class="note">Online card/UPI checkout is not connected yet. This records payments you collect in person.</p></div>
 <div class="tbox" data-tab="overview"><h4>Reset sales data</h4><p class="note">Deletes all saved offline orders, so Payments totals and the Most ordered chart go back to ₹0. This cannot be undone. Menu, prices and settings are not touched.</p><label class="note"><input type="checkbox" id="rsB"> Also delete all bookings</label><input id="rsT" placeholder="Type RESET to confirm" aria-label="Type RESET to confirm"><p><button class="btn sm" data-r="go"${DB?"":" disabled"}>Reset to zero</button> <span class="note" id="rsMsg"></span></p></div>${bookingsHtml()}<div class="tbox" data-tab="popular"><h4>Most ordered items</h4>${top.map(([n,q])=>`<div class="bar"><span>${esc(n)}</span><i style="width:${Math.round(q/mx*60)+4}%"></i><span>${q}</span></div>`).join("")||'<p class="note">The chart appears after you save orders.</p>'}</div>`;showTab();}
$("adminRoot").addEventListener("change",e=>{const t=e.target;if(t.id==="dName"){DRAFT.name=t.value;const m=S.cats.flatMap(c=>c.items).find(i=>i[0]===t.value&&i[1]!=null);if(m){DRAFT.price=String(m[1]);const q=$("dPrice");if(q)q.value=DRAFT.price}}else if(t.id==="dPrice")DRAFT.price=t.value;else if(t.id==="dQty")DRAFT.qty=Math.max(1,parseInt(t.value)||1);else if(t.id==="dType")DRAFT.type=t.value;else if(t.id==="dPay")DRAFT.pay=t.value});
